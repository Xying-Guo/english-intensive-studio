{
  "manifest_version": 3,
  "name": "English Intensive Studio · 英语精学",
  "version": "0.3.3",
  "description": "在 YouTube 边看边精听：时间戳字幕、逐句循环、录音 A/B 对比，以及复制上下文给 GPT。录音不自动上传。",
  "minimum_chrome_version": "116",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "展开 / 收起页面内英语精学工作台" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["core.js", "content.js", "dock.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{ "resources": ["sidepanel.html"], "matches": ["https://www.youtube.com/*"] }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
